# Copy to .env.local and fill in the values. .env* files are not committed (except this example).

# Legacy BSS API (browser)
NEXT_PUBLIC_API_BASE_URL=https://bss-api.skyfi.network/api/bss
BASE_URL_SOCKET=https://bss-api.skyfi.network
JITSI_DOMAIN=https://meet.skyfi.network/
NEXT_PUBLIC_IS_DEV_TOOL=true

# Production values
# NEXT_PUBLIC_API_BASE_URL=https://bss-api.skyfi.pro/api/bss
# BASE_URL_SOCKET=https://socket.skyfi.pro/
# JITSI_DOMAIN=https://meet.skyfi.pro/
# NEXT_PUBLIC_IS_DEV_TOOL=false

# Sentry
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# BSS Public v2 (server-only, used by /api/bss/*)
BSS_API_BASE_URL=https://esim-uat.skyfi.com.vn
BSS_CHANNEL=BSS
BSS_PARTNER_USERNAME=
BSS_PARTNER_PASSWORD=
BSS_VIKKI_USERNAME=
BSS_VIKKI_PASSWORD=

# BSS asset host for image_url (inlined at build time — rebuild after changing)
NEXT_PUBLIC_BSS_ASSET_BASE_URL=https://esim-uat.skyfi.com.vn/
