# Copy to .env.local and fill in the values. .env* files are not committed (except this example).

# Legacy BSS API (browser)
NEXT_PUBLIC_API_BASE_URL=https://bss-api.skyfi.network/api/bss
BASE_URL_SOCKET=https://bss-api.skyfi.network
JITSI_DOMAIN=https://meet.skyfi.network/
NEXT_PUBLIC_IS_DEV_TOOL=true

# Production values
# NEXT_PUBLIC_API_BASE_URL=https://bss-api.skyfi.pro/api/bss
# BASE_URL_SOCKET=https://socket.skyfi.pro/
# JITSI_DOMAIN=https://meet.skyfi.pro/
# NEXT_PUBLIC_IS_DEV_TOOL=false

# Sentry
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# BSS Public v2 (server-only, used by /api/bss/*)
BSS_API_BASE_URL=https://esim-uat.skyfi.com.vn
BSS_CHANNEL=BSS
BSS_PARTNER_USERNAME=
BSS_PARTNER_PASSWORD=
BSS_VIKKI_USERNAME=
BSS_VIKKI_PASSWORD=

# BSS asset host for image_url (inlined at build time — rebuild after changing)
NEXT_PUBLIC_BSS_ASSET_BASE_URL=https://esim-uat.skyfi.com.vn/

# Đồng ý cookie qua CMP (CLIENT_RELAY, kind=BROWSER) — xem docs/CMP_COOKIE_CONSENT.md
# Mặc định tắt: GA4 nạp như cũ. Chỉ bật cả hai cờ sau khi onboarding CMP xong (có bundle + hash SDK).
CMP_ENABLED=false
NEXT_PUBLIC_CMP_ENABLED=false
# Origin HTTPS chính xác đã đăng ký với CMP (TBD-01), ví dụ https://skyfi.network
CMP_WEB_ORIGIN=
# URL gốc của CMP cho môi trường này (TBD-06)
CMP_BASE_URL=
# bundle.json do đội CMP gửi, và file khóa riêng sinh bằng keys.mjs (giữ trong secret store)
CMP_BUNDLE_FILE=
CMP_SECRETS_FILE=
# Hoặc dán JSON trực tiếp thay cho file: CMP_BUNDLE_JSON= / CMP_SECRETS_JSON=
# Chuỗi ngẫu nhiên >= 32 ký tự; dùng ký cookie ID trình duyệt và sinh CSRF token
CMP_SESSION_SECRET=
# File SQLite lưu quyền đã xác minh (mặc định .data/cmp-relay.sqlite)
CMP_DATABASE=
# URL SDK và hash SRI đã tự tính lại, khớp với CMP (tài liệu mục 10.1); đổi xong phải build lại
NEXT_PUBLIC_CMP_SDK_URL=
NEXT_PUBLIC_CMP_SDK_INTEGRITY=
